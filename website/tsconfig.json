{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@hyperse/inspector": ["../packages/inspector/dist/index.d.ts"],
      "@hyperse/inspector-common": [
        "../packages/inspector-common/dist/index.d.ts"
      ],
      "@hyperse/inspector-middleware": [
        "../packages/inspector-middleware/dist/index.d.ts"
      ],
      "@hyperse/inspector-babel-plugin": [
        "../packages/inspector-babel-plugin/dist/index.d.ts"
      ],
      "@hyperse/inspector-component": [
        "../packages/inspector-component/dist/index.d.ts"
      ],
      "@hyperse/next-inspector": ["../packages/next-inspector/dist/index.d.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next-intl.d.ts",
    "next-pages.d.ts",
    "**/*.ts",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".source/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
