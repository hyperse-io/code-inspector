{
  "name": "@hyperse/inspector-babel-plugin",
  "version": "2.0.4",
  "homepage": "https://github.com/hyperse-io/code-inspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/code-inspector",
    "directory": "packages/inspector-babel-plugin"
  },
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "author": {
    "name": "Hyperse",
    "url": "https://github.com/hyperse-io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.build.json && npm run minify",
    "minify": "node ../../scripts/minify.mjs --dest=dist",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "TIMING=1 eslint .",
    "test": "run-s test-unit",
    "test-task": "vitest run",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/helper-plugin-utils": "^8.0.1",
    "@hyperse/inspector-common": "workspace:*"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-plugin-utils": "^7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
