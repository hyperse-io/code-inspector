{
  "name": "hyperse-code-inspector",
  "version": "0.0.1",
  "private": true,
  "description": "The code navigation, inspect in the browser, click, open source code in your local IDE.",
  "keywords": [
    "vscode",
    "reactjs component inspector",
    "vuejs component inspector",
    "next.js inspector",
    "inspector"
  ],
  "homepage": "https://hyperse-io.github.io/code-inspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/code-inspector"
  },
  "author": {
    "name": "hyperse net",
    "url": "https://github.com/hyperse-net"
  },
  "type": "module",
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "workspaces": [
    "website",
    "packages/*",
    "crates/*",
    "examples/*"
  ],
  "scripts": {
    "g:clean": "yarn clean:global-cache && yarn workspaces foreach -At run clean",
    "g:build": "yarn g:build-local",
    "g:build-local": "yarn workspaces foreach -At run build",
    "g:build-website": "yarn workspace @hyperse/code-inspector-website run build:ghpage",
    "g:test": "yarn workspaces foreach -At run test",
    "g:test-unit": "yarn workspaces foreach --all -ptv run test-unit",
    "g:test-e2e": "yarn workspaces foreach -At run test-e2e",
    "g:test-coverage": "yarn workspaces foreach -At run test-coverage",
    "g:lint": "yarn workspaces foreach -At run lint",
    "g:typecheck": "yarn workspaces foreach -At run typecheck",
    "g:lint-staged-files": "lint-staged --allow-empty",
    "g:fix-all-files": "yarn workspaces foreach -At run fix-all-files",
    "g:changeset": "changeset",
    "g:version": "changeset version",
    "g:release": "yarn g:build && changeset publish",
    "clean:global-cache": "rimraf --no-glob ./dist ./coverage ./__data__ ./config/__data__ ./tsconfig.tsbuildinfo",
    "g:cz": "cz",
    "g:publish-local": "yarn changeset version && cd scripts && ./publish-to-verdaccio.sh",
    "prepare": "yarn husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "webpackbar": "^7.0.0",
    "dts-bundle-generator/typescript": "^6.0.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": "please-use-yarn",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@4.18.1"
}
